# Replace the domain and certificate paths. Place the frontend behind this gateway.
# This template assumes the standard Compose loopback frontend port 3010.
events {}
http {
    limit_req_zone $binary_remote_addr zone=auth:10m rate=30r/m;
    limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=execution:10m rate=12r/m;
    limit_req_status 429;
    client_max_body_size 128k;
    client_body_timeout 10s;
    client_header_timeout 10s;
    server_tokens off;
    upstream python_frontend { server 127.0.0.1:3010; }
    server {
        listen 80;
        server_name python.example.com;
        return 301 https://python.example.com$request_uri;
    }
    server {
        listen 443 ssl;
        server_name python.example.com;
        ssl_certificate /etc/nginx/tls/fullchain.pem;
        ssl_certificate_key /etc/nginx/tls/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 75s;
        location /api/auth/ {
            limit_req zone=auth burst=10 nodelay;
            proxy_pass http://python_frontend;
        }
        location ~ ^/api/exercises/[^/]+/submit$ {
            limit_req zone=execution burst=3 nodelay;
            proxy_read_timeout 180s;
            proxy_pass http://python_frontend;
        }
        location /api/ {
            limit_req zone=api burst=30 nodelay;
            proxy_pass http://python_frontend;
        }
        location / {
            proxy_pass http://python_frontend;
        }
    }
}
